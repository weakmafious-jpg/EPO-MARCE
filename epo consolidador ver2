    def _copy_worksheet(self, dst, src):
        for row in src.iter_rows():
            for cell in row:
                new_cell = dst.cell(row=cell.row, column=cell.column, value=cell.value)
                if cell.has_style:
                    try:
                        new_cell.font = cell.font.copy()
                        new_cell.border = cell.border.copy()
                        new_cell.fill = cell.fill.copy()
                        new_cell.number_format = cell.number_format
                        new_cell.alignment = cell.alignment.copy()
                    except:
                        pass
        for col, dim in src.column_dimensions.items():
            try:
                dst.column_dimensions[col].width = dim.width
            except: pass
        for row, dim in src.row_dimensions.items():
            try:
                dst.row_dimensions[row].height = dim.height
            except: pass
        try:
            for merged_range in src.merged_cells.ranges:
                dst.merge_cells(str(merged_range))
        except: pass

