    def _read_excel_any(self, path):
        xls = pd.ExcelFile(path)
        frames=[]
        default_year=self._year_from_filename(path)
        for sh in xls.sheet_names:
            raw=pd.read_excel(path, sheet_name=sh, header=None, dtype=object)
            df_tpl=self._parse_epo_template_sheet(raw, sh, default_year)
            if df_tpl is not None and not df_tpl.empty:
                frames.append(df_tpl); continue
            try:
                df_named=pd.read_excel(path, sheet_name=sh, dtype=str, header=0)
                if df_named is not None and not df_named.empty:
                    norm=self._normalize_table(df_named, sheet_name=sh)
                    if norm is not None and not norm.empty:
                        frames.append(norm)
            except Exception:
                pass
        return frames

    def _parse_epo_template_sheet(self, raw_df, sheet_name: str, default_year: int):
        if raw_df is None or raw_df.empty: return pd.DataFrame(columns=["proveedor","categoria","mes","valor"])
        df = raw_df.fillna("")
        header_row=None; cat_col_idx=None
        for i in range(min(30, len(df))):
            row_lower=[str(c).strip().lower() for c in df.iloc[i].tolist()]
            if "categoría" in row_lower or "categoria" in row_lower:
                header_row=i
                cat_col_idx = (row_lower.index("categoría") if "categoría" in row_lower else row_lower.index("categoria"))
                break
        if header_row is None or cat_col_idx is None:
            return pd.DataFrame(columns=["proveedor","categoria","mes","valor"])
        month_row=None
        for r in range(header_row-1, max(-1, header_row-4), -1):
            if r<0: break
            cells=[str(c).strip().lower() for c in df.iloc[r].tolist()]
            if any(any(k in c for k in MONTHS_MAP.keys()) for c in cells):
                month_row=r; break
        if month_row is None:
            return pd.DataFrame(columns=["proveedor","categoria","mes","valor"])
        month_cells=[str(c).strip().lower() for c in df.iloc[month_row].tolist()]
        months_by_col={}
        current=""
        for j,cell in enumerate(month_cells):
            detected=None
            for k,v in MONTHS_MAP.items():
                if k in cell and cell!="":
                    detected=v; break
            if detected:
                current=f"{int(default_year):04d}-{int(detected):02d}"
            months_by_col[j]=current
        out_rows=[]
        for i in range(header_row+1, len(df)):
            first_cell = str(df.iat[i, cat_col_idx]).strip()
            if first_cell == "":
                if i>header_row+2 and str(df.iat[i-1, cat_col_idx]).strip() == "":
                    break
                continue
            if "total" in first_cell.lower(): break
            categoria=first_cell
            for j in range(cat_col_idx+1, df.shape[1]):
                prov_name=str(df.iat[header_row, j]).strip()
                if prov_name=="" or "total" in prov_name.lower(): continue
                mes_txt=months_by_col.get(j, "")
                if mes_txt=="": continue
                val=_to_float(df.iat[i, j])
                if val!=0.0:
                    out_rows.append((prov_name, categoria, mes_txt, val))
        if not out_rows: return pd.DataFrame(columns=["proveedor","categoria","mes","valor"])
        out=pd.DataFrame(out_rows, columns=["proveedor","categoria","mes","valor"])
        out["proveedor"]=out["proveedor"].astype(str).str.strip()
        out["categoria"]=out["categoria"].astype(str).str.strip()
        return out

    def _normalize_table(self, df, sheet_name=None):
        cols=[str(c).strip() for c in df.columns]; df.columns=cols
        def _guess_cols(cols):
            iv=im=ip=ic=None
            for c in cols:
                lc=c.lower()
                if ic is None and re.search(r"(categ|familia|línea|linea|producto|item)",lc): ic=c
                if ip is None and re.search(r"(prove|vendor|marca|brand|supplier)",lc): ip=c
                if iv is None and re.search(r"(monto|valor|importe|amount|total|epo)",lc): iv=c
                if im is None and re.search(r"(mes|month|fecha|periodo|per[ií]odo)",lc): im=c
            return ip,ic,im,iv
        ip,ic,im,iv=_guess_cols(cols)
        if all(x is not None for x in (ip,ic,im,iv)):
            out=pd.DataFrame({
                "proveedor": df[ip].astype(str).str.strip(),
                "categoria": df[ic].astype(str).str.strip(),
                "mes": df[im].astype(str),
                "valor": df[iv].apply(_to_float)
            })
            out=out[out["mes"]!=""]
            return out
        return pd.DataFrame(columns=["proveedor","categoria","mes","valor"])

    def _guess_from_name(self, path, kind="kam"):
        name=os.path.splitext(os.path.basename(path))[0]
        parts=re.split(r"[-_]", name)
        if kind=="kam":
            for p in parts:
                if p.lower().startswith(("kam","asesor")): return p
            return parts[0] if parts else ""
        else:
            if len(parts)>1: return parts[1]
            return ""

    def _year_from_filename(self, path: str, fallback=None) -> int:
        m = re.search(r"(20\d{2})", os.path.basename(path))
        return int(m.group(1)) if m else (fallback if fallback is not None else dt.date.today().year)

    def _load_base(self):
        if pd is None:
            QtWidgets.QMessageBox.information(self,"Dependencia","Instala pandas para importar."); return
        path,_=QtWidgets.QFileDialog.getOpenFileName(self,"Cargar base","","Hojas (*.xlsx *.xls *.csv)")
        if not path: return
        try:
            frames=[]
            if path.lower().endswith(".csv"):
                d=pd.read_csv(path, dtype=str, keep_default_na=False)
                frames=[self._normalize_table(d)]
            else:
                xl=pd.ExcelFile(path)
                guess_year=self._year_from_filename(path)
                for sh in xl.sheet_names:
                    raw=pd.read_excel(path, sheet_name=sh, header=None, dtype=object)
                    df_tpl=self._parse_epo_template_sheet(raw, sh, guess_year)
                    if df_tpl is not None and not df_tpl.empty:
                        frames.append(df_tpl); continue
                    try:
                        n=pd.read_excel(path, sheet_name=sh, dtype=str)
                        n=self._normalize_table(n)
                        if n is not None and not n.empty:
                            frames.append(n)
                    except Exception:
                        pass
            if not frames:
                QtWidgets.QMessageBox.warning(self,"Base","No se detectaron datos compatibles en el archivo."); return
            base_all=pd.concat(frames, ignore_index=True)
            base_all=base_all[base_all["mes"]!=""].copy()
            base_all["valor"]=base_all["valor"].astype(float)
            if base_all.empty:
                QtWidgets.QMessageBox.warning(self,"Base","No se encontraron columnas de Mes/Valor en formato compatible."); return
            years = base_all["mes"].str[:4].dropna().astype(int)
            self.base_year = int(years.mode().iat[0]) if not years.empty else self._year_from_filename(path)
            self.base_prov = base_all.groupby("proveedor", as_index=False)["valor"].sum()
            self.base_prov.columns=["proveedor","valor"]
            self.base_month = base_all.groupby("mes", as_index=False)["valor"].sum()
            QtWidgets.QMessageBox.information(self,"Base","Base cargada.")
        except Exception as e:
            QtWidgets.QMessageBox.warning(self,"Base",str(e))
        self._recalc()

    def _switch_group_mode(self, txt):
        self.group_mode = "proveedor" if (txt or "").lower().startswith("prove") else "mes"
        self._recalc()

    def _recalc(self, force=False):
        if self.df is None or self.df.empty:
            self.kpi_total.value.setText("$ 0")
            self.kpi_provs.value.setText("0")
            self.kpi_clients.value.setText("0")
            if self.base_month is not None and not self.base_month.empty:
                sum_base=float(self.base_month["valor"].sum())
                self.kpi_vs.value.setText(f"{((0.0/sum_base)-1.0)*100:,.2f}%" if sum_base>0 else "—")
            else:
                self.kpi_vs.value.setText("—")
            self.curr_year=dt.date.today().year
            if self.group_mode=="proveedor":
                self._fill_main_table(pd.DataFrame(columns=["proveedor","EPO","Base","Diff"]), mode="proveedor")
            else:
                self._fill_main_table(pd.DataFrame(columns=["Mes","EPO","Base","Diff"]), mode="mes")
            return
        d=self.df.copy(); d["valor"]=d["valor"].astype(float)
        if "mes" in d.columns and not d["mes"].eq("").all():
            yseries = d.loc[d["mes"]!="","mes"].str[:4].astype(int)
            self.curr_year = int(yseries.mode().iat[0]) if not yseries.empty else dt.date.today().year
        else:
            self.curr_year = dt.date.today().year
        total=float(d["valor"].sum())
        self.kpi_total.value.setText(f"$ {total:,.0f}")
        self.kpi_provs.value.setText(f"{d[d['proveedor']!='']['proveedor'].nunique():,}")
        self.kpi_clients.value.setText(f"{d['cliente'].nunique():,}")
        if self.base_month is not None and not self.base_month.empty:
            mes=d[d["mes"]!=""].groupby("mes", as_index=False)["valor"].sum().rename(columns={"valor":"EPO"})
            bm=self.base_month.copy(); bm["mm"]=bm["mes"].str[-2:]
            mes["mm"]=mes["mes"].str[-2:]
            m_join=mes.merge(bm[["mm","valor"]].rename(columns={"valor":"Base"}), on="mm", how="left")
            sum_curr=float(m_join["EPO"].sum())
            sum_base=float(m_join["Base"].fillna(0.0).sum())
            self.kpi_vs.value.setText(f"{((sum_curr/sum_base)-1.0)*100:,.2f}%" if sum_base>0 else "—")
        else:
            self.kpi_vs.value.setText("—")
        if self.group_mode=="proveedor":
            prov=d[d["proveedor"]!=""].groupby("proveedor", as_index=False).agg({"valor":"sum"}).rename(columns={"valor":"EPO"})
            if self.base_prov is not None and not self.base_prov.empty:
                b=self.base_prov.rename(columns={"valor":"Base"})
                prov=prov.merge(b, on="proveedor", how="left").fillna({"Base":0.0})
            else:
                prov["Base"]=0.0
            prov["Diff"]=prov["EPO"]-prov["Base"]
            prov=prov.sort_values("EPO", ascending=False)
            self._fill_main_table(prov, mode="proveedor")
        else:
            mlist=[]
            for i in range(12):
                mm=f"{i+1:02d}"
                epo=float(d.loc[d["mes"].str[-2:]==mm,"valor"].sum())
                base=0.0
                if self.base_month is not None and not self.base_month.empty:
                    base=float(self.base_month.loc[self.base_month["mes"].str[-2:]==mm,"valor"].sum())
                mlist.append({"Mes":SPAN_MONTHS[i],"EPO":epo,"Base":base,"Diff":epo-base})
            self._fill_main_table(pd.DataFrame(mlist), mode="mes")

    def _fill_main_table(self, df, mode="proveedor"):
        base_lbl = f"Ventas Base{(' ' + str(self.base_year)) if self.base_year else ''}"
        curr_lbl = f"EPO Año{(' ' + str(self.curr_year)) if self.curr_year else ''}"
        diff_lbl = "Diferencia vs Base"
        if mode=="proveedor":
            self.lbl_main_title.setText("Totales por proveedor")
            headers=["Proveedor", base_lbl, curr_lbl, diff_lbl]
            self.tbl_main.setRowCount(0); self.tbl_main.setColumnCount(len(headers)); self.tbl_main.setHorizontalHeaderLabels(headers)
            if df is None or df.empty: return
            self.tbl_main.setRowCount(len(df))
            for r,row in enumerate(df.itertuples(index=False)):
                proveedor=getattr(row,"proveedor","")
                base=float(getattr(row,"Base",0.0)); epo=float(getattr(row,"EPO",0.0)); diff=float(getattr(row,"Diff",epo-base))
                self.tbl_main.setItem(r,0,QtWidgets.QTableWidgetItem(str(proveedor)))
                self.tbl_main.setItem(r,1,QtWidgets.QTableWidgetItem(f"{base:,.0f}"))
                self.tbl_main.setItem(r,2,QtWidgets.QTableWidgetItem(f"{epo:,.0f}"))
                self.tbl_main.setItem(r,3,QtWidgets.QTableWidgetItem(f"{diff:,.0f}"))
        else:
            self.lbl_main_title.setText("Totales por mes")
            headers=["Mes", curr_lbl, base_lbl, diff_lbl]
            self.tbl_main.setRowCount(0); self.tbl_main.setColumnCount(len(headers)); self.tbl_main.setHorizontalHeaderLabels(headers)
            if df is None or df.empty: return
            self.tbl_main.setRowCount(len(df))
            for r,row in enumerate(df.itertuples(index=False)):
                mes=str(getattr(row,"Mes",""))
                epo=float(getattr(row,"EPO",0.0)); base=float(getattr(row,"Base",0.0)); diff=float(getattr(row,"Diff",epo-base))
                self.tbl_main.setItem(r,0,QtWidgets.QTableWidgetItem(mes))
                self.tbl_main.setItem(r,1,QtWidgets.QTableWidgetItem(f"{epo:,.0f}"))
                self.tbl_main.setItem(r,2,QtWidgets.QTableWidgetItem(f"{base:,.0f}"))
                self.tbl_main.setItem(r,3,QtWidgets.QTableWidgetItem(f"{diff:,.0f}"))

    def _open_full_format(self):
        if pd is None: return
        df = None if (self.df is None or self.df.empty) else self.df[["proveedor","categoria","mes","valor"]]
        FullFormatDialog(self, df=df).exec()

    def _export_total(self, mode="epo"):
        if Workbook is None:
            QtWidgets.QMessageBox.information(self,"Exportar","Instala openpyxl para exportar a Excel."); return
        if mode == "kam":
            try:
                self._run_kam_flow()
            except Exception as e:
                QtWidgets.QMessageBox.warning(self,"Reporte KAM",str(e))
            return
        try:
            src_paths,_ = QtWidgets.QFileDialog.getOpenFileNames(self, "Selecciona archivos EPO", "", "Excel (*.xlsx *.xlsm *.xls)")
            if not src_paths:
                QtWidgets.QMessageBox.information(self, "EPO Ventas", "No seleccionaste archivos")
                return
            out_path,_ = QtWidgets.QFileDialog.getSaveFileName(self, "Guardar consolidado", "EPO_Ventas.xlsx", "Excel (*.xlsx)")
            if not out_path:
                return
            out_wb = Workbook()
            try:
                out_wb.remove(out_wb.active)
            except:
                pass

            for path in src_paths:
                try:
                    wb = load_workbook(path, data_only=True)
                except Exception as e:
                    QtWidgets.QMessageBox.warning(self,"EPO Ventas",f"No se pudo abrir {os.path.basename(path)}: {e}")
                    continue
                for ws in wb.worksheets:
                    a1 = str(ws["A1"].value or "").strip()
                    base_name = a1 if a1 else (ws.title.strip() if ws.title else os.path.splitext(os.path.basename(path))[0])
                    title = _safe_sheet_name(base_name)
                    if title in out_wb.sheetnames:
                        i = 2
                        while f"{title} ({i})" in out_wb.sheetnames:
                            i += 1
                        title = f"{title} ({i})"
                    new_ws = out_wb.create_sheet(title)
                    self._copy_worksheet(new_ws, ws)

            # Construir hoja TOTALES con la corrección
            self._build_totales_sheet(out_wb)

            out_wb.save(out_path)
            QtWidgets.QMessageBox.information(self,"EPO Ventas","Consolidado generado con hojas copiadas y hoja TOTALES.")
        except Exception as e:
            QtWidgets.QMessageBox.warning(self,"EPO Ventas", f"Error: {str(e)}")

    def _run_kam_flow(self):
        if pd is None or Workbook is None:
            QtWidgets.QMessageBox.information(self,"Reporte KAM","Requiere pandas y openpyxl instalados.")
            return
        mode_items = ["Reemplazar mes", "Sumar al mes"]
        mode, ok = QtWidgets.QInputDialog.getItem(
            self, "Modo de escritura", "¿Cómo aplicar los valores al mes detectado?",
            mode_items, 0, False
        )
        if not ok:
            return
        add_mode = (mode == mode_items[1])
        editable_path, _ = QtWidgets.QFileDialog.getOpenFileName(
            self, "Selecciona EDITABLE.xlsx", "", "Excel (*.xlsx *.xls)"
        )
        if not editable_path:
            return
        dest_existing_path = None
        if add_mode:
            dest_existing_path, _ = QtWidgets.QFileDialog.getOpenFileName(
                self, "Selecciona archivo EPO DESTINO (donde se sumará)", "", "Excel (*.xlsx *.xls)"
            )
            if not dest_existing_path:
                return
        opciones = ["OFFICE DEPOT MEXICO","LUMEN","COPPEL","WALMART","SEARS","OTRO"]
        cliente, ok = QtWidgets.QInputDialog.getItem(
            self, "Cliente", "Selecciona el cliente:", opciones, 0, True
        )
        if not ok or not cliente:
            return
        mes_str, year, month = _detect_mes_anio_from_editable(editable_path)
        if not mes_str:
            QtWidgets.QMessageBox.information(
                self, "Reporte KAM",
                "No se pudo detectar Mes/Año en H1. Formato esperado (ej. '02 de Octubre de 2025')."
            )
            return
        try:
            df = pd.read_excel(editable_path, sheet_name=0, header=None, dtype=object)
            df = df.fillna("")
            categorias = df.iloc[:, 1].astype(str).tolist() if df.shape[1] >= 2 else []
            proveedores = df.iloc[:, 2].astype(str).tolist() if df.shape[1] >= 3 else []
            valores     = df.iloc[:, 8].tolist()           if df.shape[1] >= 9 else []
            pairs = []
            for cat, prov, val in zip(categorias, proveedores, valores):
                cat_n = _norm_text(cat); prov_n = _norm_text(prov); v = _to_float(val)
                if cat_n and prov_n and v != 0.0:
                    pairs.append((str(cat).strip(), _apply_alias(str(prov).strip()), v))
            if add_mode:
                wb = load_workbook(dest_existing_path)
                ws = wb["Formato"] if "Formato" in wb.sheetnames else wb.active
            else:
                template_path = _get_template_path()
                wb = load_workbook(template_path)
                ws = wb["Formato"] if "Formato" in wb.sheetnames else wb.active
            ws["A1"] = cliente
            month_blocks, _, _, _ = _scan_template_grid(ws)
            if month not in month_blocks:
                raise RuntimeError("No se encontró el bloque del mes en la plantilla/destino.")
            col_ini, col_fin = month_blocks[month]
            cat_map, prov_map = _make_maps_by_name(ws)
            prov_relaxed = getattr(ws, "_prov_relaxed", {})
            cat_relaxed  = getattr(ws, "_cat_relaxed", {})
            prov_keys_rel = list(prov_relaxed.keys())
            cat_keys_rel  = list(cat_relaxed.keys())
            written_ct = 0; skipped_ct = 0; sum_in = 0.0; sum_written = 0.0; skipped_rows = []
            for cat, prov_raw, v in pairs:
                sum_in += float(v)
                prov = prov_raw
                r = cat_map.get(_norm_text(cat))
                if r is None:
                    r = cat_relaxed.get(_norm_relaxed(cat))
                if r is None:
                    k = _best_match_relaxed(cat, cat_keys_rel, min_sim=0.55)
                    if k is not None:
                        r = cat_relaxed.get(k)
                if r is None:
                    skipped_ct += 1; skipped_rows.append((cat, prov, v, "Categoría no encontrada")); continue
                c = prov_map.get(_norm_text(prov))
                if c is None:
                    c = prov_relaxed.get(_norm_relaxed(prov))
                target_c = None
                if c is not None and (col_ini <= c <= col_fin):
                    target_c = c
                else:
                    prov_rel = _norm_relaxed(prov)
                    for cc in range(col_ini, col_fin + 1):
                        name = str(ws.cell(row=5, column=cc).value or "").strip()
                        if not name or "total" in name.lower(): continue
                        name_rel = _norm_relaxed(name)
                        if name_rel == prov_rel or prov_rel in name_rel or name_rel in prov_rel:
                            target_c = cc; break
                    if target_c is None:
                        best_cc = None; best_sc = 0.0
                        for cc in range(col_ini, col_fin + 1):
                            name = str(ws.cell(row=5, column=cc).value or "").strip()
                            if not name or "total" in name.lower(): continue
                            sc = _jaccard(prov, name)
                            if sc > best_sc: best_sc = sc; best_cc = cc
                        if best_sc >= 0.55:
                            target_c = best_cc
                if target_c is None:
                    skipped_ct += 1; skipped_rows.append((cat, prov, v, "Proveedor no encontrado")); continue
                cell = ws.cell(row=r, column=target_c)
                if add_mode:
                    prev = _to_float(cell.value)
                    cell.value = prev + float(v)
                else:
                    cell.value = float(v)
                sum_written += float(v); written_ct += 1
            if add_mode:
                suggested = os.path.splitext(os.path.basename(dest_existing_path))[0]
                out_path, _ = QtWidgets.QFileDialog.getSaveFileName(
                    self, "Guardar (sumado)", f"{suggested}_sumado.xlsx", "Excel (*.xlsx)"
                )
            else:
                out_path, _ = QtWidgets.QFileDialog.getSaveFileName(
                    self, "Guardar reporte", f"EPO_{year}_{cliente}.xlsx", "Excel (*.xlsx)"
                )
            if not out_path:
                return
            wb.save(out_path)
            msg = (f"Cliente: {cliente}\n"
                   f"Mes detectado: {SPAN_MONTHS[month-1]} {year}\n"
                   f"Modo: {mode}\n"
                   f"Filas leídas: {len(pairs):,}\n"
                   f"Celdas escritas: {written_ct:,}\n"
                   f"Sin coincidencia: {skipped_ct:,}\n"
                   f"\nTotal EDITABLE: $ {sum_in:,.0f}\n"
                   f"Total escrito:  $ {sum_written:,.0f}\n"
                   f"Diferencia:     $ {sum_in - sum_written:,.0f}\n"
                   f"\nArchivo guardado:\n{out_path}")
            QtWidgets.QMessageBox.information(self, "Reporte KAM - Auditoría", msg)
        except Exception as e:
            QtWidgets.QMessageBox.warning(self, "Reporte KAM", str(e))

