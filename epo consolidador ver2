NUM_RX=re.compile(r"[^\d\-\.,]")

def _to_float(x) -> float:
    if x is None: return 0.0
    s=str(x).strip()
    if s=="" or s.lower() in ("nan","none","-","--"): return 0.0
    s=NUM_RX.sub("",s).replace(",",".")
    try: return float(s)
    except: return 0.0

def _norm_text(s: str) -> str:
    t = (str(s) if s is not None else "").strip().lower()
    t = re.sub(r"[\n\r]+"," ", t)
    t = re.sub(r"\s+"," ", t)
    t = t.replace(".","").replace(",","")
    repl = {"á":"a","é":"e","í":"i","ó":"o","ú":"u","ñ":"n","ü":"u"}
    t = "".join(repl.get(ch, ch) for ch in t)
    return t

_CORP_SUFFIX_RX = re.compile(
    r"\b(s\.?\s?a\.?(?:\s?de)?\s?c\.?\s?v\.?|s\.?\s?de\s?r\.?\s?l\.?\s?de\s?c\.?\s?v\.?|inc\.?|corp\.?|co\.?|ltd\.?)\b",
    re.IGNORECASE,
)
_PUNCT_RX = re.compile(r"[^\w\s]")

def _norm_relaxed(s: str) -> str:
    t = _norm_text(s)
    t = _CORP_SUFFIX_RX.sub("", t)
    t = _PUNCT_RX.sub(" ", t)
    t = re.sub(r"\s+", " ", t).strip()
    return t

ALIASES = {"ghtlink": "ght link", "beifa": "beifa import"}
def _apply_alias(p: str) -> str:
    return ALIASES.get(_norm_relaxed(p), p)

def _jaccard(a: str, b: str) -> float:
    sa = set(_norm_relaxed(a).split()); sb = set(_norm_relaxed(b).split())
    if not sa or not sb: return 0.0
    inter=len(sa & sb); uni=len(sa | sb)
    return inter/uni if uni else 0.0

def _best_match_relaxed(target: str, pool_keys: List[str], min_sim: float=0.55) -> Optional[str]:
    t = _norm_relaxed(target)
    if t in pool_keys: return t
    for k in pool_keys:
        if t in k or k in t: return k
    best_k=None; best_sc=0.0; sa=set(t.split())
    for k in pool_keys:
        sb=set(k.split())
        sc = (len(sa & sb)/len(sa | sb)) if (sa and sb) else 0.0
        if sc>best_sc: best_sc=sc; best_k=k
    return best_k if best_sc>=min_sim else None

def _parse_spanish_h1_date(texto: str):
    if not texto: return "", None, None
    t=str(texto).strip().lower()
    t=re.sub(r"\s+"," ",t)
    m=re.search(r"(?:\d{1,2}\s+de\s+)?([a-záéíóú]+)(?:\s+de)?\s+(\d{4})", t)
    if not m: return "", None, None
    mes_pal=m.group(1); anio=int(m.group(2))
    mes=MONTHS_MAP.get(mes_pal[:3], None)
    if not mes: return "", None, None
    return f"{anio:04d}-{mes:02d}", anio, mes

def _detect_mes_anio_from_editable(path_editable: str, sheet_name=0):
    try:
        h1 = pd.read_excel(path_editable, sheet_name=sheet_name, header=None, nrows=1, usecols="H").iat[0,0]
    except Exception:
        return "", None, None
    return _parse_spanish_h1_date(h1)

def _safe_sheet_name(name: str) -> str:
    name = (name or "").strip()
    name = re.sub(r"[\[\]\:\*\?\/\\]", " ", name)
    name = re.sub(r"\s+", " ", name).strip()
    if not name: name = "Cliente"
    return name[:31]

def _get_template_path() -> str:
    fname = "Form_EPO_Marce.xlsx"
    base_dirs: List[str] = []
    if hasattr(sys, "_MEIPASS") and sys._MEIPASS:
        base_dirs.append(sys._MEIPASS)
    if getattr(sys, "frozen", False):
        try:
            base_dirs.append(os.path.dirname(sys.executable))
        except Exception:
            pass
    try:
        base_dirs.append(os.path.dirname(os.path.abspath(__file__)))
    except Exception:
        pass
    base_dirs.append(os.getcwd())
    for base in base_dirs:
        p = os.path.join(base, "plantillas", fname)
        if os.path.exists(p):
            return p
    for base in base_dirs:
        p = os.path.join(base, fname)
        if os.path.exists(p):
            return p
    detail = "\n".join(f" - {b}" for b in base_dirs)
    raise FileNotFoundError(
        "No se encontró 'Form_EPO_Marce.xlsx'.\nRutas probadas:\n"+detail+"\n\nInclúyela al empaquetar (PyInstaller):\n  --add-data \"plantillas\\Form_EPO_Marce.xlsx;plantillas\"\n  --add-data \"plantillas/Form_EPO_Marce.xlsx:plantillas\"\no colócala junto al EXE dentro de 'plantillas/'."
    )

def _scan_template_grid(ws: Worksheet) -> Tuple[Dict[int, Tuple[int,int]], Dict[int, int], Dict[int,int], int]:
    month_blocks: Dict[int, Tuple[int,int]] = {}
    current_mm=None; start=None
    max_col = ws.max_column
    for c in range(1, max_col+1):
        v = str(ws.cell(row=4, column=c).value or "").strip().lower()
        mm=None
        for k,vv in MONTHS_MAP.items():
            if k in v and v!="":
                mm=vv; break
        if mm is not None:
            if current_mm is not None and start is not None:
                month_blocks[current_mm]=(start, c-1)
            current_mm=mm; start=c
    if current_mm is not None and start is not None:
        month_blocks[current_mm]=(start, max_col)
    providers = {}
    # FIX: había "range(1 1, max_col+1)"
    for c in range(1, max_col+1):
        name = str(ws.cell(row=5, column=c).value or "").strip()
        if not name: continue
        if "total" in name.lower(): continue
        providers[c]=c
    cat_row={}
    r=6; blanks=0
    while r <= ws.max_row:
        val = ws.cell(row=r, column=1).value
        if val is None or str(val).strip()=="":
            blanks+=1
            if blanks>=2: break
            r+=1; continue
        if "total" in str(val).strip().lower():
            break
        cat_row[r]=r
        r+=1
    first_data_row=6
    return month_blocks, providers, cat_row, first_data_row

def _detect_total_row(ws: Worksheet) -> int:
    try:
        for r in range(6, ws.max_row + 1):
            val = ws.cell(row=r, column=1).value
            if val and "total" in str(val).strip().lower():
                return r
    except Exception:
        pass
    try:
        _, _, cat_rows, _ = _scan_template_grid(ws)
        if cat_rows:
            return max(cat_rows.keys()) + 1
    except Exception:
        pass
    return 69

def validar_total_categoria(ws: Worksheet):
    total_row = _detect_total_row(ws)
    month_blocks, _, cat_rows, _ = _scan_template_grid(ws)
    for mm, (c1, c2) in month_blocks.items():
        total_col = c2
        for r in cat_rows.keys():
            if r >= total_row:
                continue
            vals = [_to_float(ws.cell(row=r, column=c).value) for c in range(c1, c2)]
            suma = sum(vals[:-1])
            total_val = _to_float(ws.cell(row=r, column=total_col).value)
            if abs(suma - total_val) > 0.01:
                print(f"[WARN] Fila {r}: suma {suma} != total {total_val}")

def validar_ytd_no_decreciente(ws: Worksheet):
    total_row = _detect_total_row(ws)
    month_blocks, _, _, _ = _scan_template_grid(ws)
    prev_vals = [0.0] * 16
    for mm in sorted(month_blocks.keys()):
        c1, c2 = month_blocks[mm]
        vals = [_to_float(ws.cell(row=total_row, column=c).value) for c in range(c1, c2)]
        for i, v in enumerate(vals):
            if v < prev_vals[i]:
                print(f"[WARN] Mes {mm}: decreciente en proveedor {i+1} ({prev_vals[i]} to {v})")
        prev_vals = vals

def _make_maps_by_name(ws: Worksheet) -> Tuple[Dict[str,int], Dict[str,int]]:
    cat_map={}; cat_relaxed={}
    r=6
    while r<=ws.max_row:
        val = ws.cell(row=r, column=1).value
        if val is None or str(val).strip()=="":
            r+=1; continue
        txt=str(val).strip()
        if "total" in txt.lower(): break
        cat_map[_norm_text(txt)] = r
        cat_relaxed[_norm_relaxed(txt)] = r
        r+=1
    prov_map={}; prov_relaxed={}
    for c in range(1, ws.max_column+1):
        name = ws.cell(row=5, column=c).value
        if name is None: continue
        name=str(name).strip()
        if name=="" or "total" in name.lower(): continue
        prov_map[_norm_text(name)] = c
        prov_relaxed[_norm_relaxed(name)] = c
    ws._prov_relaxed = prov_relaxed
    ws._cat_relaxed = cat_relaxed
    return cat_map, prov_map

def _read_epo_sheet_as_records(ws: Worksheet) -> List[Tuple[str,str,int,float]]:
    month_blocks, providers_cols, cat_rows, _ = _scan_template_grid(ws)
    if not month_blocks: return []
    prov_by_col={c: str(ws.cell(row=5, column=c).value or "").strip() for c in providers_cols.keys()}
    records=[]
    for mm,(c1,c2) in month_blocks.items():
        has_data=False
        for r in cat_rows.keys():
            for c in range(c1, c2+1):
                v=_to_float(ws.cell(row=r, column=c).value)
                if v!=0.0:
                    has_data=True; break
            if has_data: break
        if not has_data: continue
        for r in cat_rows.keys():
            cat = str(ws.cell(row=r, column=1).value or "").strip()
            if not cat: continue
            if "total" in cat.lower(): continue
            for c in range(c1, c2+1):
                prov = prov_by_col.get(c, "")
                if not prov or "total" in prov.lower(): continue
                v=_to_float(ws.cell(row=r, column=c).value)
                if v!=0.0:
                    records.append((cat, prov, mm, v))
    return records

def _write_records_into_template(ws: Worksheet, records: List[Tuple[str,str,int,float]]):
    if not records: return
    cat_map, prov_map = _make_maps_by_name(ws)
    month_blocks, _, _, _ = _scan_template_grid(ws)
    if not month_blocks: return
    prov_relaxed = getattr(ws, "_prov_relaxed", {})
    cat_relaxed  = getattr(ws, "_cat_relaxed", {})
    prov_keys_rel = list(prov_relaxed.keys())
    cat_keys_rel  = list(cat_relaxed.keys())
    for cat, prov_raw, mm, val in records:
        if mm not in month_blocks: continue
        prov = _apply_alias(prov_raw)
        r = cat_map.get(_norm_text(cat))
        if r is None:
            r = cat_relaxed.get(_norm_relaxed(cat))
        if r is None:
            k = _best_match_relaxed(cat, cat_keys_rel, min_sim=0.55)
            if k is not None: r = cat_relaxed.get(k)
        if r is None: continue
        c = prov_map.get(_norm_text(prov))
        if c is None:
            c = getattr(ws, "_prov_relaxed", {}).get(_norm_relaxed(prov))
        col_ini, col_fin = month_blocks[mm]
        target_c = None
        if c is not None and (col_ini <= c <= col_fin):
            target_c = c
        else:
            prov_rel = _norm_relaxed(prov)
            for cc in range(col_ini, col_fin+1):
                name = str(ws.cell(row=5, column=cc).value or "").strip()
                if not name or "total" in name.lower(): continue
                name_rel = _norm_relaxed(name)
                if name_rel == prov_rel or prov_rel in name_rel or name_rel in prov_rel:
                    target_c = cc; break
            if target_c is None:
                best_cc=None; best_sc=0.0
                for cc in range(col_ini, col_fin+1):
                    name=str(ws.cell(row=5, column=cc).value or "").strip()
                    if not name or "total" in name.lower(): continue
                    sc=_jaccard(prov, name)
                    if sc>best_sc: best_sc=sc; best_cc=cc
                if best_sc>=0.55: target_c=best_cc
        if target_c is None: continue
        cell = ws.cell(row=r, column=target_c)
        prev=_to_float(cell.value)
        cell.value = prev + float(val)

def _paste_literal_grid(new_ws: Worksheet, src_ws: Worksheet):
    month_blocks_dst, providers_cols_dst, cat_rows_dst, _ = _scan_template_grid(new_ws)
    if not month_blocks_dst or not providers_cols_dst or not cat_rows_dst:
        return
    month_blocks_src, providers_cols_src, cat_rows_src, _ = _scan_template_grid(src_ws)
    if not month_blocks_src or not providers_cols_src or not cat_rows_src:
        return
    min_row = max(6, min(cat_rows_dst.keys()))
    max_row = max(cat_rows_dst.keys())
    for mm, (c1_dst, c2_dst) in month_blocks_dst.items():
        if mm not in month_blocks_src:
            continue
        c1_src, c2_src = month_blocks_src[mm]
        width = min(c2_dst - c1_dst + 1, c2_src - c1_src + 1)
        for r in range(min_row, max_row + 1):
            head = str(new_ws.cell(row=r, column=1).value or "").strip().lower()
            if head == "" or "total" in head:
                continue
            for offset in range(width):
                c_dst = c1_dst + offset
                c_src = c1_src + offset
                fv = _to_float(src_ws.cell(row=r, column=c_src).value)
                if fv != 0.0:
                    prev = _to_float(new_ws.cell(row=r, column=c_dst).value)
                    new_ws.cell(row=r, column=c_dst, value=prev + fv)

def _col_idx(col: str) -> int:
    idx = 0
    for ch in col.strip().upper():
        idx = idx * 26 + (ord(ch) - 64)
    return idx

def _force_paste_december_block(new_ws: Worksheet, src_ws: Worksheet):
    month_blocks_src, _, _, _ = _scan_template_grid(src_ws)
    if 12 not in month_blocks_src:
        return
    c1_src, c2_src = month_blocks_src[12]
    c1_dst = _col_idx("GG")
    c2_dst = _col_idx("GW")
    width_src = c2_src - c1_src + 1
    width_dst = c2_dst - c1_dst + 1
    width = min(width_src, width_dst)
    total_row = _detect_total_row(src_ws)
    for r in range(6, total_row + 1):
        for off in range(width):
            fv = _to_float(src_ws.cell(row=r, column=c1_src + off).value)
            if fv != 0.0:
                new_ws.cell(row=r, column=c1_dst + off, value=fv)

class FullFormatDialog(QtWidgets.QDialog):
    def __init__(self, parent=None, df=None):
        super().__init__(parent)
        self.setWindowTitle("Comparativa avanzada")
        self.resize(1200, 780)
        self.setModal(True)
        self.setStyleSheet(f"""
            QDialog{{background:{BG};color:{TEXT};}}
            QLineEdit{{background:{SURF1};border:1px solid {BORDER};border-radius:10px;padding:8px 10px;color:{TEXT};selection-background-color:{ACCENT};}}
            QLineEdit:focus{{border:1px solid {ACCENT};}}
            QPushButton#ghost{{background:{SURF1};border:1px solid {BORDER};color:{TEXT};border-radius:10px;padding:8px 12px;}}
            QPushButton#ghost:hover{{border-color:{ACCENT};}}
            QTableWidget{{background:{SURF1};border:1px solid {BORDER};border-radius:{RADIUS-2}px;}}
            QHeaderView::section{{background:{SURF1};color:{TEXT_M};border:none;padding:6px;font-weight:700;}}
            QTableCornerButton::section{{background:{SURF1};border:0px;}}
            QScrollBar:vertical{{background:{SURF1};width:12px;border:none;border-radius:6px;}}
            QScrollBar::handle:vertical{{background:{ACCENT};min-height:24px;border-radius:6px;}}
            QScrollBar:horizontal{{background:{SURF1};height:12px;border:none;border-radius:6px;}}
            QScrollBar::handle:horizontal{{background:{ACCENT};min-width:24px;border-radius:6px;}}
        """)
        self._source_df = df[["proveedor","categoria","mes","valor"]].copy() if (df is not None and not df.empty) else (pd.DataFrame(columns=["proveedor","categoria","mes","valor"]) if pd is not None else None)
        v = QtWidgets.QVBoxLayout(self); v.setContentsMargins(12,12,12,12); v.setSpacing(8)
        top = QtWidgets.QHBoxLayout()
        self.search = QtWidgets.QLineEdit(); self.search.setPlaceholderText("Buscar proveedor o categoría…")
        self.search.setClearButtonEnabled(True)
        self.search.textChanged.connect(self._apply_filter)
        top.addWidget(self.search, 1)
        btnClose = QtWidgets.QPushButton("Cerrar", objectName="ghost"); btnClose.clicked.connect(self.accept)
        btnClose.setFocusPolicy(QtCore.Qt.NoFocus)
        top.addWidget(btnClose)
        v.addLayout(top)
        self.table = QtWidgets.QTableWidget(); v.addWidget(self.table,1)
        if pd is not None:
            self._build_pivot(self._source_df)

    def _build_pivot(self, df):
        if df is None or df.empty:
            self.table.setRowCount(0); self.table.setColumnCount(0); return
        df2 = df.copy()
        df2 = df2[df2["mes"]!=""]
        if df2.empty:
            self.table.setRowCount(0); self.table.setColumnCount(0); return
        df2["mes_txt"]=df2["mes"].str[-2:].astype(int)
        piv = df2.pivot_table(index=["proveedor","categoria"], columns="mes_txt",
                              values="valor", aggfunc="sum", fill_value=0.0)
        piv = piv.reindex(columns=list(range(1,13)), fill_value=0.0)
        piv.columns = [m[:3] for m in SPAN_MONTHS]
        piv["Total"]=piv.sum(axis=1)
        tot = float(piv["Total"].sum()) or 1.0
        piv["Participación"]=piv["Total"]/tot
        self._piv = piv.reset_index()
        self._render(self._piv)

    def _apply_filter(self, text):
        if not hasattr(self, "_piv") or self._piv is None:
            return
        t = (text or "").strip().lower()
        if t == "":
            df = self._piv
        else:
            m1 = self._piv["proveedor"].astype(str).str.lower().str.contains(t, na=False)
            m2 = self._piv["categoria"].astype(str).str.lower().str.contains(t, na=False)
            df = self._piv[m1 | m2]
        self._render(df)

    def _render(self, df_show):
        months_short = [m[:3] for m in SPAN_MONTHS]
        cols=["Proveedor","Categoría"]+months_short+["Total","Participación"]
        self.table.setColumnCount(len(cols)); self.table.setHorizontalHeaderLabels(cols)
        self.table.setRowCount(len(df_show))
        for r in range(len(df_show)):
            self.table.setItem(r,0,QtWidgets.QTableWidgetItem(str(df_show.iat[r,0])))
            self.table.setItem(r,1,QtWidgets.QTableWidgetItem(str(df_show.iat[r,1])))
            for i in range(12):
                self.table.setItem(r,2+i,QtWidgets.QTableWidgetItem(f"{df_show.iat[r,2+i]:,.0f}"))
            self.table.setItem(r,14,QtWidgets.QTableWidgetItem(f"{df_show.iat[r,14]:,.0f}"))
            self.table.setItem(r,15,QtWidgets.QTableWidgetItem(f"{df_show.iat[r,15]*100:,.2f}%"))
        self.table.horizontalHeader().setSectionResizeMode(QtWidgets.QHeaderView.ResizeToContents)

