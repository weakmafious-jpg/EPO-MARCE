    def _build_totales_sheet(self, wb):
        src_names = [n for n in wb.sheetnames if n.upper() != "TOTALES"]
        if not src_names:
            return

        tot_cat = defaultdict(lambda: [0.0]*12)   # categoría x mes
        tot_prov = defaultdict(lambda: [0.0]*12)  # proveedor x mes
        tot_mes = [0.0]*12                        # total por mes

        category_order: List[str] = []
        provider_order = OrderedDict()

        def _is_total_header(txt: str) -> bool:
            t = (txt or "").strip().lower()
            return bool(re.search(r"(total|ytd|acumulado|a[ñn]o)", t))

        for nm in src_names:
            ws = wb[nm]
            try:
                mb, _, cat_rows, _ = _scan_template_grid(ws)
            except Exception:
                continue
            if not mb or not cat_rows:
                continue

            if not category_order:
                for r in sorted(cat_rows.keys()):
                    name = str(ws.cell(row=r, column=1).value or "").strip()
                    if name and "total" not in name.lower():
                        category_order.append(name)

            total_row = _detect_total_row(ws)

            for mm in range(1, 13):
                if mm not in mb:
                    continue
                c1, c2 = mb[mm]

                prov_cols_block: List[Tuple[str,int]] = []
                for cc in range(c1, c2+1):
                    hdr = str(ws.cell(row=5, column=cc).value or "").strip()
                    if hdr and not _is_total_header(hdr):
                        prov_cols_block.append((hdr, cc))
                        if hdr not in provider_order:
                            provider_order[hdr] = True

                # A) categoría: suma de columnas de proveedores del bloque
                for r in sorted(cat_rows.keys()):
                    if r >= total_row:
                        continue
                    cat_name = str(ws.cell(row=r, column=1).value or "").strip()
                    if not cat_name or "total" in cat_name.lower():
                        continue
                    s = 0.0
                    for _, cc in prov_cols_block:
                        s += _to_float(ws.cell(row=r, column=cc).value)
                    if s != 0.0:
                        tot_cat[cat_name][mm-1] += s

                # B) proveedor: usar fila de totales por proveedor (total_row)
                for prov_name, cc in prov_cols_block:
                    v = _to_float(ws.cell(row=total_row, column=cc).value)
                    if v != 0.0:
                        tot_prov[prov_name][mm-1] += v

                # C) total del mes: suma de total_row solo en columnas de proveedores
                v_mes = 0.0
                for _, cc in prov_cols_block:
                    v_mes += _to_float(ws.cell(row=total_row, column=cc).value)
                if v_mes != 0.0:
                    tot_mes[mm-1] += v_mes

        if "TOTALES" in wb.sheetnames:
            tot_ws = wb["TOTALES"]
            try:
                tot_ws.delete_rows(1, tot_ws.max_row)
            except:
                pass
        else:
            tot_ws = wb.create_sheet("TOTALES")

        def _row(ws, r, c, values):
            for i, val in enumerate(values):
                ws.cell(row=r, column=c+i, value=val)

        r = 1
        _row(tot_ws, r, 1, ["Totales por Categoría (suma de columnas de proveedores por mes, todas las hojas)"]); r += 1
        headers_A = ["Categoría"] + SPAN_MONTHS + ["Total"]
        _row(tot_ws, r, 1, headers_A); r += 1

        cats_to_write = category_order[:]
        for k in tot_cat.keys():
            if k not in cats_to_write:
                cats_to_write.append(k)

        for cat in cats_to_write:
            meses = tot_cat.get(cat, [0.0]*12)
            total_cat = sum(meses)
            _row(tot_ws, r, 1, [cat] + [float(m) for m in meses] + [float(total_cat)])
            r += 1

        r += 1
        _row(tot_ws, r, 1, ["Totales por Proveedor (fila total por proveedor y mes, todas las hojas)"]); r += 1
        headers_B = ["Proveedor"] + SPAN_MONTHS + ["Total"]
        _row(tot_ws, r, 1, headers_B); r += 1

        provs_to_write = list(provider_order.keys())
        for k in tot_prov.keys():
            if k not in provs_to_write:
                provs_to_write.append(k)

        for prov in provs_to_write:
            meses = tot_prov.get(prov, [0.0]*12)
            total_prov = sum(meses)
            _row(tot_ws, r, 1, [prov] + [float(m) for m in meses] + [float(total_prov)])
            r += 1

        r += 1
        _row(tot_ws, r, 1, ["Totales por Mes (suma de proveedores por mes, todas las hojas)"]); r += 1
        headers_C = ["Mes", "Total del Mes", "% del Total"]
        _row(tot_ws, r, 1, headers_C); r += 1
        gran_total = float(sum(tot_mes))
        start_C_data = r
        for i, mname in enumerate(SPAN_MONTHS):
            v = float(tot_mes[i])
            pct = (v/gran_total) if gran_total > 0 else 0.0
            _row(tot_ws, r, 1, [mname, v, pct])
            r += 1
        _row(tot_ws, r, 1, ["Gran Total", float(gran_total)]); r += 1

        try:
            max_row = tot_ws.max_row
            max_col = tot_ws.max_column
            for rr in range(1, max_row+1):
                for cc in range(1, max_col+1):
                    cell = tot_ws.cell(row=rr, column=cc)
                    val = cell.value
                    if isinstance(val, (int, float)):
                        cell.number_format = '#,##0'
            for rr in range(start_C_data, start_C_data + 12):
                tot_ws.cell(row=rr, column=3).number_format = '0.00%'
            tot_ws.column_dimensions['A'].width = 36
            for i in range(12):
                tot_ws.column_dimensions[get_column_letter(2+i)].width = 14
            tot_ws.column_dimensions[get_column_letter(14)].width = 16
        except:
            pass
    # ======= FIN CORRECCIÓN =======

